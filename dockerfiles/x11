FROM --platform=linux/386 alpine:3.20
#FROM docker.io/i386/alpine:3.17

RUN echo -e "\n@testing https://dl-cdn.alpinelinux.org/alpine/edge/testing" >> /etc/apk/repositories

# Minimal X11 stack
RUN apk add --no-cache xorg-server xf86-video-fbdev xf86-input-libinput xinit xterm twm mesa-dri-gallium bash nano 

# Add user
RUN adduser -D -s /bin/bash user && echo "user:password" | chpasswd && echo "root:password" | chpasswd

# Misc Configuration
RUN echo "xterm" > ~/.xinitrc

ENV HOME=/home/user USER=user SHELL=/bin/bash TERM=xterm-256color

CMD ["/bin/sh"]

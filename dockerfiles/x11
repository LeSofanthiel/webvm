FROM --platform=linux/386 i386/alpine:17

RUN echo "https://dl-cdn.alpinelinux.org/alpine/v3.17/main
" > /etc/apk/repositories && echo "https://dl-cdn.alpinelinux.org/alpine/v3.17/community
" >> /etc/apk/repositories

RUN apk add --no-cache bash nano curl python3 lua5.4 luajit xorg-server xf-video-vesa xf86-input-libinput xinit xterm dbus font-dejavu ttf-freefont twm

RUN adduser -D -s /bin/bash user && echo "user:password" | chpasswd && echo "root:password" | chpasswd

WORKDIR /home/user

ENV HOME=/home/user USER=user SHELL=/bin/bash TERM=xterm-256color

CMD ["/bin/bash"]
